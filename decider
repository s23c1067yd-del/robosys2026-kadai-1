import random
import sys

if len(sys.argv) >= 2:
try:
    random.seed(int(sys.argv[1]))
except ValueError:
    print("seed must be an integer", file=sys.stderr)
    sys.exit(1)

choices = [line.strip() for line in sys.stdin if line.strip()]
if not choices:
print("no input", file=sys.stderr)
sys.exit(1)

print(f"{random.choice(choices)} にしましょう！")
