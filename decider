import random
import sys


def parse_seed(args):
    if not args:
        return None
    if len(args) > 1 or not args[0].lstrip("-").isdigit():
        sys.exit(1)
    return int(args[0])


def main():
    seed = parse_seed(sys.argv[1:])
    if seed is not None:
        random.seed(seed)

    if sys.stdin.isatty():
        print("どのご飯屋さんと迷ってる？（1行ずつ入力して、終わったら空行でEnter）")
        choices = []
        while True:
            line = input("> ").strip()
            if not line:
                if choices:
                    break
                continue
            choices.append(line)
    else:
        choices = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]

    if not choices:
        sys.exit(1)

    shop = random.choice(choices)
    print(f"{shop}にしよう！")

    if sys.stdin.isatty():
        ans = input("メニューも選んであげようか？ (yes/no) > ").strip().lower()
        if ans in ("yes", "y"):
            print("メニュー候補を1行ずつ入力して、終わったら空行でEnter")
            menus = []
            while True:
                try:
                    m = input("> ").strip()
                except EOFError:
                    break
                if not m:
                    if menus:
                        break
                    continue
                menus.append(m)
            chosen_menu = random.choice(menus)
            print(f"{shop}の{chosen_menu}にしよう！")


if __name__ == "__main__":
    main()
